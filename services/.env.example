# Copy to services/.env and fill in. Nothing here is a secret: user access tokens
# are created with `python -m invoice_service.admin add-user NAME` and stored hashed.

# ----------------------------------------------------------------- backend
# The domain Caddy gets an HTTPS certificate for; it must point at this machine.
API_DOMAIN=invoices.example.com
# Exactly your GitHub Pages origin: scheme and host, no path, no trailing slash.
ALLOWED_ORIGINS=https://tuhsori-lab.github.io

MAX_UPLOAD_MB=20
MAX_PAGES=30
MAX_PAGE_PIXELS=40000000
JOB_SECONDS=300
MAX_ATTEMPTS=3
REQUESTS_PER_MINUTE=600
UPLOADS_PER_HOUR=200
RETENTION_DAYS=30

# OCR engine. Model names are pinned so benchmark results stay comparable.
OCR_LANG=en
OCR_DPI_LADDER=200,300
OCR_DET_MODEL=PP-OCRv6_medium_det
OCR_REC_MODEL=PP-OCRv6_medium_rec
OCR_ORIENTATION_MODEL=PP-LCNet_x1_0_doc_ori

# The acceptance policy written by `python -m invoice_service.benchmark --calibrate`.
# Mount it into /data and point here, e.g. POLICY_FILE=/data/policy.json
POLICY_FILE=
